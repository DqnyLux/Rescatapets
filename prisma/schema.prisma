generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int       @id @default(autoincrement())
  nombre   String
  email    String    @unique
  reportes Reporte[]
}

model Reporte {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String
  ubicacion   String
  tipo        String
  estado      String   @default("PUBLICO")
  fecha       DateTime @default(now())
  
  usuarioId   Int
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
}
